# Copy to .env and fill in. Never commit real values.

# --- Control plane -----------------------------------------------------------
DATABASE_URL=postgresql://amanah:amanah@localhost:5432/amanah?schema=public
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# --- Auth (Keycloak) ---------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=amanah
KEYCLOAK_CLIENT_ID=amanah-api

# --- Messaging ---------------------------------------------------------------
RABBITMQ_URL=amqp://amanah:amanah@localhost:5672/

# --- Retrieval ---------------------------------------------------------------
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=amanah_chunks
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Generation --------------------------------------------------------------
# Leave empty for the offline deterministic stub.
LITELLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Privacy -----------------------------------------------------------------
PII_REDACTION_ENABLED=true
PII_RESTORE_RESPONSE=true

# --- Web ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
