{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amanah.example/events/document.uploaded.v1.schema.json",
  "title": "document.uploaded.v1",
  "description": "Published by the control plane after metadata is committed. Consumed by the ingestion worker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "document"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": { "const": "document.uploaded.v1" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "language", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "language": { "type": "string", "enum": ["ar", "en"] },
        "text": { "type": "string", "minLength": 1 },
        "source_uri": { "type": ["string", "null"] },
        "checksum": { "type": ["string", "null"], "maxLength": 64 }
      }
    }
  }
}
